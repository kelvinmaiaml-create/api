<!DOCTYPE html>
<html lang='pt-br'>
    <head>
        <meta charset = "UTF-8">
        <title>CRUD SHOW</title>
    </head>
    <body>
        <h2>Registros salvos</h2>
        <table border="1">
            <thead>
                <tr>
                    <td> Nome</td>
                    <td>Sobrenome</td>
                    <td>Ação</td>
                </tr>
            </thead>

        <tbody>
            <%crud.foreach(function(details){%>
                <tr>
                    <td>
                        <%= details.name%>
                    </td>
                    <td>
                        <%= details.surname%>
                    </td>
                    <td>
                        <a href="/edit/<%= details._id %>"></a> - <a href="/delete/<%= details._id %>">Deletar</a>
                    </td>
                </tr>
            <%}) %>
        </tbody>
        </table><button><a href="/index">Novo </button>

        <form action = "/show" method="POST">
            <input type="text" placeholder="Nome" name="name">
            <input type="text" placeholder="Sobrenome" name="surname">
            <button type="submit">Enviar</button>
        </form>
            
    </body>
</html>